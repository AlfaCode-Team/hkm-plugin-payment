{
    "name": "alfacode-team/hkm-plugin-payment",
    "description": "HKM Kernel plugin providing 'payment.processing' — a provider-agnostic payments ledger with a MarzPay driver.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "hkm-kernel",
        "plugin",
        "php",
        "payment.processing",
        "marzpay",
        "mobile-money"
    ],
    "require": {
        "php": ">=8.4",
        "alfacode-team/php-service-platform": "dev-master",
        "alfacode-team/hkm-plugin-database": "dev-main",
        "alfacode-team/hkm-plugin-http-client": "dev-main"
    },
    "autoload": {
        "psr-4": {
            "Plugins\\Payment\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Unit\\Plugins\\Payment\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11 || ^12 || ^13"
    },
    "repositories": [
        { "type": "vcs", "url": "https://github.com/AlfaCode-Team/hkm-kernel" },
        { "type": "vcs", "url": "https://github.com/AlfaCode-Team/http" },
        { "type": "vcs", "url": "https://github.com/AlfaCode-Team/php-io-cli" },
        { "type": "vcs", "url": "https://github.com/AlfaCode-Team/Let-Migrate" },
        { "type": "vcs", "url": "https://github.com/hakrichTech/bindIt" },
        { "type": "vcs", "url": "https://github.com/hakrichTech/type-alias" },
        { "type": "vcs", "url": "https://github.com/AlfaCode-Team/hkm-plugin-database" },
        { "type": "vcs", "url": "https://github.com/AlfaCode-Team/hkm-plugin-http-client" }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true
}
